generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AvailabilitySource {
  operator
  places
  osm
  live_feed
}

enum AvailabilityState {
  live
  estimated
  unknown
}

enum SuggestionStatus {
  pending
  approved
  rejected
}

enum ReviewThumb {
  up
  down
}

enum ReviewReason {
  close_enough
  too_far
  used_other
}

model ParkingLot {
  id                String             @id @default(cuid())
  name              String
  lat               Float
  lng               Float
  address           String?
  priceText         String?
  hoursText         String?
  notes             String?
  lotKind           String?
  source            AvailabilitySource @default(operator)
  availabilityState AvailabilityState  @default(unknown)
  hidden            Boolean            @default(false)
  city              String             @default("bangalore")
  externalId        String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([city, hidden])
  @@index([lat, lng])
}

model Destination {
  id            String   @id @default(cuid())
  googlePlaceId String?  @unique
  name          String
  address       String?
  lat           Float
  lng           Float
  queryText     String?
  lastSeen      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([name])
}

model ParkingSuggestion {
  id         String           @id @default(cuid())
  name       String
  lat        Float
  lng        Float
  address    String?
  priceText  String?
  hoursText  String?
  notes      String?
  lotKind    String?
  status     SuggestionStatus @default(pending)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?
}

model ParkingCache {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ParkingReview {
  id        String       @id @default(cuid())
  lotId     String
  lotName   String
  lotLat    Float?
  lotLng    Float?
  destName  String
  destLat   Float?
  destLng   Float?
  thumb     ReviewThumb
  reason    ReviewReason
  createdAt DateTime     @default(now())

  @@index([lotId, createdAt])
  @@index([thumb])
}
