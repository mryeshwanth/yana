generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AvailabilitySource {
  operator
  places
  osm
  live_feed
}

enum AvailabilityState {
  live
  estimated
  unknown
}

enum SuggestionStatus {
  pending
  approved
  rejected
}

model ParkingLot {
  id                String             @id @default(cuid())
  name              String
  lat               Float
  lng               Float
  address           String?
  priceText         String?
  hoursText         String?
  notes             String?
  source            AvailabilitySource @default(operator)
  availabilityState AvailabilityState  @default(unknown)
  hidden            Boolean            @default(false)
  city              String             @default("bangalore")
  externalId        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([city, hidden])
  @@index([lat, lng])
}

model ParkingSuggestion {
  id         String           @id @default(cuid())
  name       String
  lat        Float
  lng        Float
  address    String?
  priceText  String?
  hoursText  String?
  notes      String?
  status     SuggestionStatus @default(pending)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?
}

model ParkingCache {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}
