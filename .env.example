DATABASE_URL="postgresql://USER@localhost:5432/yana"

# Server key — enable Places API (New) + Routes API.
# Restrict by IP if you have one; otherwise leave open only while prototyping.
GOOGLE_MAPS_API_KEY=""

# Browser key — enable Maps JavaScript API only.
# Restrict by HTTP referrer: http://localhost:3000/* and your share host.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

ADMIN_PASSWORD="yana-admin"
ADMIN_SESSION_SECRET="change-me-in-production"

OVERPASS_URL="https://overpass.osm.ch/api/interpreter"
